/** Escenario: marco, linea de defensa, suelo y HUD con puntaje y marcianos restantes. */
class Board {
    field int score, aliens;

    constructor Board new(int total) {
        let score = 0;
        let aliens = total;
        return this;
    }

    method void dispose() {
        do Memory.deAlloc(this);
        return;
    }

    /** Altura de la linea de defensa: si un marciano la toca, se pierde. */
    function int line() {
        return 204;
    }

    method void draw() {
        var int x;

        do erase();
        do Screen.setColor(true);
        do Screen.drawRectangle(0, 14, 511, 15);      // separador del HUD
        do Screen.drawRectangle(2, 16, 3, 235);       // pared izquierda
        do Screen.drawRectangle(508, 16, 509, 235);   // pared derecha
        do Screen.drawRectangle(0, 236, 511, 255);    // suelo

        let x = 8;
        while (x < 500) {
            do Screen.setColor(true);
            do Screen.drawRectangle(x, Board.line(), x + 7, Board.line() + 1);
            do Screen.setColor(false);                // ventanas de la ciudad
            do Screen.drawRectangle(x, 241, x + 3, 244);
            do Screen.drawRectangle(x + 8, 248, x + 11, 251);
            let x = x + 16;
        }

        do Screens.text(0, 2, "PUNTOS:");
        do Screens.text(0, 25, "SPACE INVADERS");
        do Screens.text(0, 48, "MARCIANOS:");
        do show();
        return;
    }

    method void erase() {
        do Screen.clearScreen();
        return;
    }

    /** Suma los puntos de un marciano derribado y refresca el HUD. */
    method void update(int points, int left) {
        let score = score + points;
        let aliens = left;
        do show();
        return;
    }

    method void show() {
        do Output.moveCursor(0, 10);
        do Output.printInt(score);
        do Output.moveCursor(0, 59);
        do Output.printInt(aliens);
        do Output.printChar(32);   // borra el digito sobrante al pasar de 10 a 9
        return;
    }

    method int score() {
        return score;
    }
}
