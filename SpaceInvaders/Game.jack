/** Una partida: crea las entidades y ejecuta el bucle principal. */
class Game {
    field Board board;
    field Player player;
    field Bullet bullet;
    field Fleet fleet;

    constructor Game new() {
        let board = Board.new(12);
        let player = Player.new();
        let bullet = Bullet.new();
        let fleet = Fleet.new();
        do board.draw();
        do player.draw();
        do fleet.draw();
        return this;
    }

    method void dispose() {
        do board.dispose();
        do player.dispose();
        do bullet.dispose();
        do fleet.dispose();
        do Memory.deAlloc(this);
        return;
    }

    /** Juega hasta ganar o perder. Devuelve false si el jugador salio con Q. */
    method boolean run() {
        var char key;
        var int points;

        while (~(won() | fleet.landed())) {
            let key = Keyboard.keyPressed();
            if (key = 81) {   // Q
                return false;
            }
            if (key = 130) {  // flecha izquierda
                do player.moveLeft();
            }
            if (key = 132) {  // flecha derecha
                do player.moveRight();
            }
            if (key = 32) {   // espacio
                do bullet.fire(player.gunX());
            }

            do bullet.update();
            do fleet.update();
            let points = fleet.shoot(bullet);
            if (points > 0) {
                do board.update(points, fleet.alive());
            }
            do Sys.wait(40);
        }
        do board.erase();
        return true;
    }

    method boolean won() {
        return fleet.alive() = 0;
    }

    method int score() {
        return board.score();
    }
}
