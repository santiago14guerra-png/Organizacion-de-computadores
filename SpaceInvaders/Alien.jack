/** Un marciano. Los sprites son bitmaps de 22x16 escritos directo en la memoria de video,
 *  por eso x debe ser multiplo de 16. */
class Alien {
    static Array screen, sprites;

    field int x, y, type, frame;   // type: 0 = calamar (20 pts), 1 = cangrejo (10 pts)
    field boolean alive;

    /** Construye los sprites una sola vez, al arrancar el programa. */
    function void init() {
        var Array s;

        let screen = 16384;
        let sprites = Array.new(5);

        let s = Array.new(16);   // calamar, cuadro 0
        let sprites[0] = s;
        do Alien.row(s, 0, "....XX.....");
        do Alien.row(s, 1, "...XXXX....");
        do Alien.row(s, 2, "..XXXXXX...");
        do Alien.row(s, 3, ".XX.XX.XX..");
        do Alien.row(s, 4, ".XXXXXXXX..");
        do Alien.row(s, 5, "...X..X....");
        do Alien.row(s, 6, "..X.XX.X...");
        do Alien.row(s, 7, ".X.X..X.X..");

        let s = Array.new(16);   // calamar, cuadro 1
        let sprites[1] = s;
        do Alien.row(s, 0, "....XX.....");
        do Alien.row(s, 1, "...XXXX....");
        do Alien.row(s, 2, "..XXXXXX...");
        do Alien.row(s, 3, ".XX.XX.XX..");
        do Alien.row(s, 4, ".XXXXXXXX..");
        do Alien.row(s, 5, "..X.XX.X...");
        do Alien.row(s, 6, ".X......X..");
        do Alien.row(s, 7, "..X....X...");

        let s = Array.new(16);   // cangrejo, cuadro 0
        let sprites[2] = s;
        do Alien.row(s, 0, "..X.....X..");
        do Alien.row(s, 1, "...X...X...");
        do Alien.row(s, 2, "..XXXXXXX..");
        do Alien.row(s, 3, ".XX.XXX.XX.");
        do Alien.row(s, 4, "XXXXXXXXXXX");
        do Alien.row(s, 5, "X.XXXXXXX.X");
        do Alien.row(s, 6, "X.X.....X.X");
        do Alien.row(s, 7, "...XX.XX...");

        let s = Array.new(16);   // cangrejo, cuadro 1
        let sprites[3] = s;
        do Alien.row(s, 0, "..X.....X..");
        do Alien.row(s, 1, "X..X...X..X");
        do Alien.row(s, 2, "X.XXXXXXX.X");
        do Alien.row(s, 3, "XXX.XXX.XXX");
        do Alien.row(s, 4, "XXXXXXXXXXX");
        do Alien.row(s, 5, ".XXXXXXXXX.");
        do Alien.row(s, 6, "..X.....X..");
        do Alien.row(s, 7, ".X.......X.");

        let s = Array.new(16);   // explosion
        let sprites[4] = s;
        do Alien.row(s, 0, ".X...X...X.");
        do Alien.row(s, 1, "..X..X..X..");
        do Alien.row(s, 2, "...X...X...");
        do Alien.row(s, 3, "XX.......XX");
        do Alien.row(s, 4, "...X...X...");
        do Alien.row(s, 5, "..X..X..X..");
        do Alien.row(s, 6, ".X...X...X.");
        do Alien.row(s, 7, "...........");
        return;
    }

    /** Traduce una fila de arte ASCII a dos palabras de 16 bits, con cada pixel al doble de ancho. */
    function void row(Array sprite, int r, String art) {
        var int i, word, mask, left, right;

        let mask = 1;
        let i = 0;
        while (i < art.length()) {
            if (art.charAt(i) = 88) {   // 'X'
                if (word = 0) {
                    let left = left | mask | (mask + mask);
                } else {
                    let right = right | mask | (mask + mask);
                }
            }
            let mask = mask + mask + mask + mask;
            if (mask = 0) {             // se desbordaron los 16 bits: sigue la otra palabra
                let mask = 1;
                let word = 1;
            }
            let i = i + 1;
        }
        let sprite[r + r] = left;
        let sprite[r + r + 1] = right;
        do art.dispose();
        return;
    }

    function void cleanup() {
        var int i;
        var Array s;

        while (i < 5) {
            let s = sprites[i];
            do s.dispose();
            let i = i + 1;
        }
        do sprites.dispose();
        return;
    }

    /** Copia un sprite a la pantalla; cada fila se repite para duplicar la altura. */
    function void blit(int px, int py, Array sprite) {
        var int addr, i;

        let addr = (py * 32) + (px / 16);
        while (i < 16) {
            let screen[addr] = sprite[i];
            let screen[addr + 1] = sprite[i + 1];
            let screen[addr + 32] = sprite[i];
            let screen[addr + 33] = sprite[i + 1];
            let addr = addr + 64;
            let i = i + 2;
        }
        return;
    }

    constructor Alien new(int ax, int ay, int atype) {
        let x = ax;
        let y = ay;
        let type = atype;
        let frame = 0;
        let alive = true;
        return this;
    }

    method void dispose() {
        do Memory.deAlloc(this);
        return;
    }

    method void draw() {
        do Alien.blit(x, y, sprites[type + type + frame]);
        return;
    }

    method void erase() {
        do Screen.setColor(false);
        do Screen.drawRectangle(x, y, x + 21, y + 15);
        return;
    }

    /** Avanza un paso y cambia de cuadro, para que mueva las patas. */
    method void step(int dx, int dy) {
        do erase();
        let x = x + dx;
        let y = y + dy;
        let frame = 1 - frame;
        do draw();
        return;
    }

    /** Muestra la explosion con una breve pausa, como el arcade, y lo saca del juego. */
    method int kill() {
        do Alien.blit(x, y, sprites[4]);
        do Sys.wait(80);
        do erase();
        let alive = false;
        return 20 - (type * 10);
    }

    method boolean isAlive() {
        return alive;
    }

    method boolean hitBy(Bullet bullet) {
        return alive & bullet.hits(x, y, 22, 16);
    }

    /** Dira si el siguiente paso horizontal lo saca de los limites del tablero. */
    method boolean atEdge(int dx) {
        return alive & (((x + dx) < 16) | ((x + dx) > 464));
    }

    method boolean reached(int lineY) {
        return alive & ((y + 15) > (lineY - 1));
    }
}
