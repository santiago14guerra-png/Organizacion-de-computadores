// Un marciano hecho con figuras de Screen, igual que el terricola.
class Marciano {
    field int x, y, tipo, cuadro; // tipo 0 = redondo (20 puntos), tipo 1 = cuadrado (10 puntos)
    field boolean vivo;

    constructor Marciano new(int posX, int posY, int t) {
        let x = posX;
        let y = posY;
        let tipo = t;
        let cuadro = 0;
        let vivo = true;
        return this;
    }

    method void dispose() {
        do Memory.deAlloc(this);
        return;
    }

    method void dibujar() {
        do Screen.setColor(true);
        if (tipo = 0) {
            do Screen.drawCircle(x + 11, y + 7, 7);
        } else {
            do Screen.drawRectangle(x + 4, y + 1, x + 18, y + 12);
        }

        if (cuadro = 0) { // patas abiertas
            do Screen.drawRectangle(x + 5, y + 13, x + 7, y + 15);
            do Screen.drawRectangle(x + 15, y + 13, x + 17, y + 15);
        } else {          // patas cerradas
            do Screen.drawRectangle(x + 8, y + 13, x + 9, y + 15);
            do Screen.drawRectangle(x + 13, y + 13, x + 14, y + 15);
        }

        do Screen.setColor(false);
        do Screen.drawRectangle(x + 7, y + 4, x + 9, y + 6);   // ojo izquierdo
        do Screen.drawRectangle(x + 13, y + 4, x + 15, y + 6); // ojo derecho
        return;
    }

    method void borrar() {
        do Screen.setColor(false);
        do Screen.drawRectangle(x, y, x + 21, y + 15);
        return;
    }

    // Para moverse se borra, cambia de posicion y se dibuja otra vez alternando las patas.
    method void mover(int pasoX, int pasoY) {
        do borrar();
        let x = x + pasoX;
        let y = y + pasoY;
        let cuadro = 1 - cuadro;
        do dibujar();
        return;
    }

    // Muestra una X un momento, la quita y devuelve sus puntos.
    method int explotar() {
        do borrar();
        do Screen.setColor(true);
        do Screen.drawLine(x + 3, y + 1, x + 18, y + 14);
        do Screen.drawLine(x + 18, y + 1, x + 3, y + 14);
        do Sys.wait(80);
        do borrar();
        let vivo = false;
        return 20 - (tipo * 10);
    }

    method boolean estaVivo() {
        return vivo;
    }

    method boolean chocaCon(Bala bala) {
        return vivo & bala.choca(x, y, 22, 16);
    }

    // Revisa si con el siguiente paso se sale del tablero.
    method boolean tocaPared(int paso) {
        return vivo & (((x + paso) < 16) | ((x + paso) > 464));
    }

    method boolean llegoA(int linea) {
        return vivo & ((y + 16) > linea);
    }
}
