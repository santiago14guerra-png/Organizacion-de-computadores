/** Punto de entrada: pantalla de inicio y una partida tras otra hasta que el jugador salga. */
class Main {

    function void main() {
        var Game game;
        var boolean playing;

        do Alien.init();
        let playing = Screens.title();
        while (playing) {
            let game = Game.new();
            let playing = game.run();
            if (playing) {
                let playing = Screens.end(game.won(), game.score());
            }
            do game.dispose();
        }
        do Screens.goodbye();
        do Alien.cleanup();
        return;
    }
}
