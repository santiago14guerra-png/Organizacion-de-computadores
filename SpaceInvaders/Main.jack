// Aqui arranca el programa: muestra el inicio y juega hasta que el jugador salga.
class Main {

    function void main() {
        var Juego juego;
        var boolean seguir;

        do Marciano.cargarDibujos();
        let seguir = Pantallas.inicio();

        while (seguir) {
            let juego = Juego.new();
            let seguir = juego.jugar();   // da false si oprimio Q
            if (seguir) {
                let seguir = Pantallas.fin(juego.gano(), juego.puntos());
            }
            do juego.dispose();
        }

        do Pantallas.despedida();
        do Marciano.liberarDibujos();
        return;
    }
}
