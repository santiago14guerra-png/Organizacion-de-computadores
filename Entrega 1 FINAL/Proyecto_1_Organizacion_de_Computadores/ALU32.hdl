// ALU32: ALU de 32 bits para Nand2Tetris

CHIP ALU32 {
    IN
        xLow[16], xHigh[16],
        yLow[16], yHigh[16],
        zx, // pone x en cero
        nx, // niega x
        zy, // pone y en cero
        ny, // niega y
        f,  // 1=suma, 0=and
        no; // niega la salida
    OUT
        outLow[16],
        outHigh[16],
        zr,      // 1 si out es cero
        ng;      // 1 si out es negativo

    PARTS:

    // Etapa X: aplica zx y nx
    Mux16(a=xLow, b=false, sel=zx, out=x1Low);
    Not16(in=x1Low, out=notx1Low);
    Mux16(a=x1Low, b=notx1Low, sel=nx, out=x2Low, out[15]=x2Low15);

    Mux16(a=xHigh, b=false, sel=zx, out=x1High);
    Not16(in=x1High, out=notx1High);
    Mux16(a=x1High, b=notx1High, sel=nx, out=x2High);

    // Etapa Y: aplica zy y ny
    Mux16(a=yLow, b=false, sel=zy, out=y1Low);
    Not16(in=y1Low, out=noty1Low);
    Mux16(a=y1Low, b=noty1Low, sel=ny, out=y2Low, out[15]=y2Low15);

    Mux16(a=yHigh, b=false, sel=zy, out=y1High);
    Not16(in=y1High, out=noty1High);
    Mux16(a=y1High, b=noty1High, sel=ny, out=y2High);

    // Rama AND (f=0)
    And16(a=x2Low,  b=y2Low,  out=andLow);
    And16(a=x2High, b=y2High, out=andHigh);

    // Rama ADD (f=1), con acarreo entre mitades
    Add16(a=x2Low, b=y2Low, out=addLow, out[15]=addLow15);

    // Carry: generate/propagate de la mitad baja
    And(a=x2Low15, b=y2Low15, out=generateCarry);
    Or(a=x2Low15,  b=y2Low15, out=propagateCarry);
    Not(in=addLow15, out=notAddLow15);
    And(a=propagateCarry, b=notAddLow15, out=propagatedCarry);
    Or(a=generateCarry, b=propagatedCarry, out=carryFromLow);

    Add16(a=x2High, b=y2High, out=addHighBase);
    Add16(a=addHighBase, b[0]=carryFromLow, out=addHigh);

    // Selecciona AND o ADD segun f
    Mux16(a=andLow,  b=addLow,  sel=f, out=foutLow);
    Mux16(a=andHigh, b=addHigh, sel=f, out=foutHigh);

    // Aplica no y arma las salidas
    Not16(in=foutLow, out=notfoutLow);
    Mux16(a=foutLow, b=notfoutLow, sel=no,
          out=outLow, out[0..7]=outByte0, out[8..15]=outByte1);

    Not16(in=foutHigh, out=notfoutHigh);
    Mux16(a=foutHigh, b=notfoutHigh, sel=no,
          out=outHigh, out[0..7]=outByte2, out[8..15]=outByte3, out[15]=ng);

    // Flag zr: cero en los 32 bits
    Or8Way(in=outByte0, out=z0);
    Or8Way(in=outByte1, out=z1);
    Or8Way(in=outByte2, out=z2);
    Or8Way(in=outByte3, out=z3);
    Or(a=z0, b=z1, out=z01);
    Or(a=z2, b=z3, out=z23);
    Or(a=z01, b=z23, out=nonzero);
    Not(in=nonzero, out=zr);
}
